{
  "name": "crew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:server": "pnpm --filter @crew/server dev",
    "dev:tasks": "pnpm --filter @crew/tasks dev",
    "dev:desktop": "pnpm --filter @crew/desktop dev",
    "db:push": "pnpm --filter @crew/db push",
    "db:studio": "pnpm --filter @crew/db studio",
    "template:build": "pnpm --filter @crew/computer template:build",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
