# Crew environment. Copy to .env and fill in. The server and the drizzle CLI
# read this file. In production, set the same values on your host.

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled connection string, used by the app
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection string, used by `pnpm db:push`
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: max connections per process (default 10)
# DATABASE_POOL_MAX=10

# ── Models (Neon AI Gateway) ────────────────────────────────────────────────
# Neon Console → your project → a branch → AI Gateway
NEON_AI_GATEWAY_BASE_URL=https://<branch-id>-api.ai.<region>.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=nt_live_...
# Optional overrides
# DEFAULT_MODEL=gpt-5-4-nano
# ROUTER_MODEL=claude-haiku-5-5

# ── Cloud computer (E2B, with Daytona as an alternative) ───────────────────
E2B_API_KEY=e2b_...
# Optional: the template built by `pnpm template:build` (faster first start).
# Leave empty to use E2B's stock "desktop" template.
# E2B_TEMPLATE_ID=crew-computer
# e2b (default) or daytona
# COMPUTER_PROVIDER=e2b
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
# Public URL of the API server. Bot turns reach first-party MCP servers
# through it, and OAuth providers redirect to $SERVER_URL/oauth/mcp/callback.
SERVER_URL=http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32  (encrypts connector tokens; don't change once set)
ENCRYPTION_KEY=
# openssl rand -hex 16  (hashes device tokens)
DEVICE_TOKEN_PEPPER=
# Optional: comma-separated emails allowed to sign up (empty = anyone)
ALLOWED_EMAILS=you@example.com,teammate@example.com

# ── Connectors that need a pre-registered OAuth app ─────────────────────────
# GitLab, Linear, Notion and Sentry register themselves automatically.
# GitHub: github.com/settings/developers → New OAuth App
#   Callback URL: $SERVER_URL/oauth/mcp/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google (personal Gmail works): console.cloud.google.com → APIs & Services
#   Enable Gmail, Calendar and Drive APIs → OAuth consent screen (External,
#   add yourself as a test user) → Credentials → OAuth client (Web)
#   Redirect URI: $SERVER_URL/oauth/mcp/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Desktop app (build time, optional; put these in apps/desktop/.env) ─────
# Server the app talks to by default (can be changed on the sign-in screen)
# MAIN_VITE_SERVER_URL=http://localhost:8787
